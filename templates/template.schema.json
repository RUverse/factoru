{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factoru.local/schemas/project-blueprint.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "description",
    "recommended",
    "pack",
    "factory",
    "team",
    "workflowPresets",
    "allowedWorkflowPresetIds",
    "defaultWorkflowPresetId"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "enum": ["standard-software-project", "fast-patch"] },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "recommended": { "type": "boolean" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lock"],
      "properties": {
        "id": { "const": "factoru-default" },
        "lock": { "type": "string", "minLength": 1 }
      }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxParallelImplementationWorkers"],
      "properties": { "maxParallelImplementationWorkers": { "const": 1 } }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_manager", "software_engineer"],
      "properties": {
        "project_manager": { "$ref": "#/$defs/teamRole" },
        "software_engineer": { "$ref": "#/$defs/teamRole" }
      }
    },
    "workflowPresets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard-build", "fast-patch"],
      "properties": {
        "standard-build": { "$ref": "#/$defs/workflowPreset" },
        "fast-patch": { "$ref": "#/$defs/workflowPreset" }
      }
    },
    "allowedWorkflowPresetIds": {
      "type": "array",
      "items": { "enum": ["standard-build", "fast-patch"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "defaultWorkflowPresetId": { "enum": ["standard-build", "fast-patch"] }
  },
  "$defs": {
    "teamRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelSlots", "defaultFormula", "memoryPolicy"],
      "properties": {
        "modelSlots": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "defaultFormula": { "type": "string", "minLength": 1 },
        "memoryPolicy": { "const": "provenance_required" }
      }
    },
    "workflowPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "formulaVersion",
        "launchMode",
        "variables",
        "maxImplementationUnits",
        "maxVerificationAttempts",
        "maxCorrectionAttempts"
      ],
      "properties": {
        "formula": { "type": "string", "minLength": 1 },
        "formulaVersion": { "type": "string", "minLength": 1 },
        "launchMode": { "enum": ["attached", "standalone"] },
        "variables": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "maxImplementationUnits": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxVerificationAttempts": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxCorrectionAttempts": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    }
  }
}
