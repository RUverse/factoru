{
  "name": "factoru",
  "version": "0.0.0",
  "private": true,
  "description": "Factoru monorepo: Factoru Desktop and Factoru Server.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test && pnpm run test:scripts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:watch": "pnpm -r run test:watch",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only server",
    "dev:desktop": "node scripts/dev.mjs --only desktop",
    "dev:env": "node scripts/dev-env.mjs",
    "clean": "pnpm -r exec rm -rf dist out .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
