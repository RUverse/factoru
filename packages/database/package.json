{
  "name": "@factoru/database",
  "version": "0.0.0",
  "private": true,
  "description": "Factoru Server SQLite schema, migrations, and persistence adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@factoru/domain": "workspace:*",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@factoru/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
